#!/bin/sh
set -eu

# A `git` that runs on the host.
#
# goose provisions the toolchain for MCP extensions with hermit, and hermit
# clones its package registry with git. org.freedesktop.Platform ships no git,
# so this shim forwards the call to the user's own installation through
# flatpak-spawn --host. FlatPark neither bundles nor configures that git; a
# machine without one gets the message below instead of a silent failure.
#
# Paths have to line up on both sides of the boundary for this to work: hermit
# passes absolute destinations under ~/.config/goose, which the manifest grants
# as a real host directory (--filesystem=~/.config/goose:create) precisely so
# that the path the sandbox names and the path the host git writes to are the
# same one.
#
# --directory keeps the working directory hermit chose. Inside the document
# portal that path has no host equivalent, so fall back to spawning without it.

if ! command -v flatpak-spawn >/dev/null 2>&1; then
  echo "goose: flatpak-spawn is unavailable, cannot reach the host git" >&2
  exit 127
fi

if ! flatpak-spawn --host sh -c 'command -v git >/dev/null 2>&1'; then
  echo "goose: no git found on the host." >&2
  echo "MCP extensions provision their toolchain with hermit, which clones its" >&2
  echo "package registry over git. Install git on the host and try again." >&2
  exit 127
fi

case "${PWD:-}" in
  /run/user/*/doc/*|/run/flatpak/doc/*|"")
    exec flatpak-spawn --host git "$@"
    ;;
esac

if [ -d "$PWD" ]; then
  exec flatpak-spawn --host --directory="$PWD" git "$@"
fi

exec flatpak-spawn --host git "$@"
