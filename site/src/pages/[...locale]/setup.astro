---
import Base from '../../layouts/Base.astro';
import Topbar from '../../components/Topbar.astro';
import { loadCatalog } from '../../lib/data.mjs';
import { localeOnlyPaths } from '../../i18n/paths.mjs';
import { getLangFromUrl, localizePath, useTranslations } from '../../i18n';

// Same page in every locale; the chrome around it is what differs.
export const getStaticPaths = localeOnlyPaths;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { repo } = loadCatalog();

const scopes = [
  { id: 'user', label: t('setup.scope.user'), flag: '--user ' },
  { id: 'system', label: t('setup.scope.system'), flag: '' },
];

const buildSteps = (flag) => [
  {
    title: t('setup.step.add_remote.title', { repo: repo.title }),
    body: t('setup.step.add_remote.body', { repo: repo.title }),
    cmd: `flatpak ${flag}remote-add --if-not-exists ${repo.remoteName} ${repo.repoFileUrl}`,
  },
  {
    title: t('setup.step.add_flathub.title'),
    body: t('setup.step.add_flathub.body', { repo: repo.title }),
    cmd: `flatpak ${flag}remote-add --if-not-exists ${repo.runtimeRemoteName} ${repo.runtimeRepoUrl}`,
  },
  {
    title: t('setup.step.install.title'),
    body: t('setup.step.install.body'),
    cmd: `flatpak ${flag}install ${repo.remoteName} <app-id>`,
  },
];
---

<Base
  title={t('setup.title', { repo: repo.title })}
  description={t('setup.meta', { repo: repo.title })}
>
  <Topbar repo={repo} />
  <main class="mx-auto max-w-3xl px-5 py-12">
    <a href={localizePath('/', lang)} class="text-sm text-muted hover:text-ink">&larr; {t('apps.all')}</a>
    <h1 class="mt-4 text-3xl font-extrabold tracking-tight">{t('setup.heading', { repo: repo.title })}</h1>
    <p class="mt-3 max-w-2xl text-muted">
      {t('setup.intro', { repo: repo.title })}</p>

    <div class="mt-6 rounded-xl border border-line bg-canvas p-4 text-sm text-muted">
      <p class="font-semibold text-ink">{t('setup.scope.question')}</p>
      <ul class="mt-2 flex flex-col gap-1.5">
        <li><span class="font-semibold text-ink">{t('setup.scope.user')}</span>{t('setup.scope.user.desc')}</li>
        <li><span class="font-semibold text-ink">{t('setup.scope.system')}</span>{t('setup.scope.system.desc')}</li>
      </ul>
      <p class="mt-2" set:html={t('setup.scope.note')}></p>
    </div>

    <div data-tabs class="mt-8">
      <div role="tablist" aria-label={t('setup.scope.aria')} class="inline-flex gap-1 rounded-lg border border-line bg-surface p-1">
        {
          scopes.map((scope, i) => (
            <button
              type="button"
              role="tab"
              data-tab={scope.id}
              aria-selected={i === 0 ? 'true' : 'false'}
              class:list={['seg', { 'is-active': i === 0 }]}
            >
              {scope.label}
            </button>
          ))
        }
      </div>

      {
        scopes.map((scope, i) => (
          <ol data-panel={scope.id} hidden={i !== 0} class="mt-6 flex flex-col gap-6">
            {buildSteps(scope.flag).map((step, j) => (
              <li class="rounded-2xl border border-line bg-surface p-5">
                <div class="flex items-center gap-3">
                  <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-brand/10 text-sm font-bold text-brand">
                    {j + 1}
                  </span>
                  <h2 class="text-base font-bold">{step.title}</h2>
                </div>
                <p class="mt-2 text-sm text-muted">{step.body}</p>
                <div class="mt-3 flex items-center gap-2">
                  <code class="cmd flex-1">{step.cmd}</code>
                  <button class="btn-ghost shrink-0" type="button" data-copy={step.cmd}>{t('action.copy')}</button>
                </div>
              </li>
            ))}
          </ol>
        ))
      }
    </div>

    <p class="mt-8 text-sm text-muted">{t('setup.outro.lead')}<a class="text-brand hover:underline" href={localizePath('/', lang)}>{t('setup.outro.catalog')}</a>{t('setup.outro.tail')}</p>
  </main>
</Base>
