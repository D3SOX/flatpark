---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Topbar from '../../components/Topbar.astro';
import { loadCatalog } from '../../lib/data.mjs';
import { getPagesFor } from '../../lib/pages';
import { pathsForLocales } from '../../i18n/paths.mjs';

export async function getStaticPaths() {
  // Slugs are locale-independent, but the *entry* is not: each locale gets its
  // translated markdown where one exists and the English body otherwise.
  return pathsForLocales(async (lang) =>
    (await getPagesFor(lang)).map(({ slug, entry }) => ({
      params: { slug },
      props: { page: entry },
    })),
  );
}

const { page } = Astro.props;
const { repo } = loadCatalog();
const { Content } = await render(page);
---

<Base title={`${page.data.title} — ${repo.title}`} description={page.data.description}>
  <Topbar repo={repo} />
  <main class="mx-auto max-w-3xl px-5 py-12">
    <article class="prose">
      <h1>{page.data.title}</h1>
      <Content />
    </article>
  </main>
</Base>
