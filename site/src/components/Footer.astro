---
import { getLangFromUrl, localizePath, useTranslations } from '../i18n';
import { getPagesFor } from '../lib/pages';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const order = ['Project', 'Docs', 'Community', 'Legal'];
// Slugs stay English across locales, so the footer is structurally identical in
// every language; only the labels and the link prefix change.
const pages = (await getPagesFor(lang)).filter(({ entry }) => !entry.data.hideFromFooter);

const groups = order
  .map((name) => ({
    name,
    items: pages
      .filter(({ entry }) => entry.data.group === name)
      .sort((a, b) => a.entry.data.order - b.entry.data.order)
      .map(({ slug, entry }) => ({ href: localizePath(`/${slug}/`, lang), label: entry.data.title })),
  }))
  .filter((g) => g.items.length);

// Links appended to a group: GitHub lives under Community, and /setup/ under
// Docs. Setup is a route rather than a content page, so it has no front matter
// to place it — and the footer is the one entry point to it that every page
// carries, now that the header no longer does.
const extras = {
  Docs: [{ href: localizePath('/setup/', lang), label: t('nav.setup') }],
  Community: [{ href: 'https://github.com/flatpark/flatpark', label: t('footer.github') }],
};
for (const g of groups) if (extras[g.name]) g.items.push(...extras[g.name]);
---

<footer class="border-t border-line">
  <div class="mx-auto max-w-6xl px-5 py-10">
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
      {groups.map((g) => (
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wide text-muted">{t(`footer.group.${g.name}`)}</h3>
          <ul class="mt-3 flex flex-col gap-2 text-sm">
            {g.items.map((it) => (
              <li><a class="text-ink/80 hover:text-brand" href={it.href}>{it.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="mt-8 text-xs text-muted">{t('footer.legal')}</p>
  </div>
</footer>
